# ==============================================================================
# Database Configuration
# ==============================================================================
# Required for running the database-backed services and migrations.
# Replace with your local PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_showcase

# ==============================================================================
# Service Ports and Paths
# ==============================================================================
# The port that the Express API server will listen on.
PORT=5000

# Base path for the Vite projects (e.g., portfolio, mockup-sandbox)
# Default is "/"
BASE_PATH=/

# ==============================================================================
# Environment Configuration
# ==============================================================================
NODE_ENV=development
LOG_LEVEL=info
